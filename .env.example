GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# Set SKIP_LLM=true to run the demo without any LLM calls.
SKIP_LLM=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_NAME=your_gemini_key_name
GEMINI_API_KEY_FALLBACK=your_second_gemini_api_key
GEMINI_API_KEY_FALLBACK_NAME=your_second_gemini_key_name
GEMINI_MODEL=gemini-2.5-flash-lite

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=memoryengine2025

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=memoryengine2025

CHROMA_PERSIST_DIRECTORY=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

API_HOST=0.0.0.0
API_PORT=8000

# OpenRouter fallback (used automatically when Gemini is unavailable)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-oss-120b
